APP_NAME="Mi Restaurante VIP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_restaurante
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@mirestaurante.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===== Facturación electrónica =====
FACTURACION_PAIS=PE
FACTURACION_ASYNC=false
FACTURACION_DISK=local

# SUNAT (Perú) — usar credenciales y certificado de PRUEBA en beta
SUNAT_AMBIENTE=beta
SUNAT_SOL_USER=MODDATOS
SUNAT_SOL_PASS=MODDATOS
# Ruta al certificado .pem (clave privada + certificado). En beta puede usarse el de Greenter.
SUNAT_CERT_PATH=storage/app/certs/certificate.pem
SUNAT_CERT_PASS=
